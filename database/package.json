{
  "name": "@strategy-game/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "generate": "prisma generate --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts",
    "migrate": "prisma migrate deploy --config prisma.config.ts",
    "migration:status": "prisma migrate status --config prisma.config.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@strategy-game/game-engine": "workspace:*",
    "@strategy-game/shared-types": "workspace:*"
  },
  "devDependencies": { "prisma": "7.10.1" }
}
