
{
  "name": "strategy-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @strategy-game/web --filter @strategy-game/server run dev",
    "dev:web": "pnpm --filter @strategy-game/web dev",
    "dev:server": "pnpm --filter @strategy-game/server dev",
    "build": "pnpm -r --if-present run build",
    "prepare:checks": "pnpm --filter @strategy-game/database... build",
    "typecheck": "pnpm prepare:checks && pnpm -r --if-present run typecheck",
    "test": "pnpm prepare:checks && vitest run",
    "test:db": "pnpm prepare:checks && node --experimental-strip-types --env-file-if-exists=.env scripts/test-database.ts",
    "db:migrate:test": "node --experimental-strip-types --env-file-if-exists=.env scripts/test-database.ts --migrate",
    "db:generate": "pnpm --filter @strategy-game/database generate",
    "db:validate": "pnpm --filter @strategy-game/database validate",
    "db:migrate": "pnpm --filter @strategy-game/database migrate",
    "db:status": "pnpm --filter @strategy-game/database migration:status",
    "lint": "pnpm --filter @strategy-game/web lint"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
