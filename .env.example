# Local development only. Replace the placeholder in all three values.
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://strategy_game_local:replace_me@127.0.0.1:5433/strategy_game_dev?schema=public
TEST_DATABASE_URL=postgresql://strategy_game_local:replace_me@127.0.0.1:5434/strategy_game_test?schema=public

# Enable only after applying migrations and configuring at least one provider.
AUTH_ENABLED=false
AUTH_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=86400
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production HTTPS reverse proxy: explicitly list only trusted proxy addresses.
AUTH_TRUST_PROXY=
